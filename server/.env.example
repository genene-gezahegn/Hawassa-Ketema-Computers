NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/hawassa_ketema
# Set DATABASE_SSL=true for hosted databases such as Neon to enforce TLS certificate verification.

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# ── Google OAuth ───────────────────────────────────────────────
# How to get your Client ID:
#   1. Visit https://console.cloud.google.com/apis/credentials
#   2. Click "Create Credentials" → "OAuth 2.0 Client ID"
#   3. Application type: Web application
#   4. Authorized JavaScript origins: http://localhost:5173 (dev)
#      and your production URL e.g. https://hawassaketema.com
#   5. No redirect URI is needed (this project uses the Google Identity
#      Services JS library with a credential callback, not a redirect flow)
#   6. Copy the Client ID (NOT the Client Secret) and paste it below
GOOGLE_CLIENT_ID=

# ── Outgoing email via Resend ─────────────────────────────────
# How to set up:
#   1. Create a free account at https://resend.com
#   2. Add your domain under "Domains" and follow the DNS verification steps
#      (or use the Resend onboarding sandbox address for initial testing)
#   3. Go to "API Keys" and create a key with "Sending access"
#   4. Paste the key below
#   5. Set AUTH_EMAIL_FROM to a verified sender on your domain,
#      e.g.  noreply@hawassaketema.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=
RESEND_TEST_TO=

# Manual bank transfer checkout
PAYMENT_BANK_NAME=Commercial Bank of Ethiopia
PAYMENT_ACCOUNT_NAME=Genene Gezahegn Galcho
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_INSTRUCTIONS=Transfer the exact order amount and submit your transaction reference from the order details page.

# Manual bank-transfer receipts always require an administrator to approve them.
